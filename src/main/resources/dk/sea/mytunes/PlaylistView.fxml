<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="200.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.sea.mytunes.gui.Controller.PlaylistViewController" styleClass="container" stylesheets="/styles/MainView.css">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <Label fx:id="lblHeading" text="New playlist" styleClass="dialog-heading" />
      <HBox alignment="CENTER_LEFT" prefHeight="78.0" prefWidth="352.0" spacing="16.0" VBox.vgrow="ALWAYS">
         <children>
            <Label prefHeight="18.0" prefWidth="53.0" text="Name" styleClass="dialog-label"/>
            <TextField fx:id="txtName" prefHeight="26.0" prefWidth="320.0" HBox.hgrow="ALWAYS" styleClass="dialog-input" />
         </children>
      </HBox>
      <HBox alignment="BOTTOM_RIGHT" layoutX="34.0" layoutY="52.0" prefHeight="78.0" prefWidth="352.0" spacing="16.0" VBox.vgrow="ALWAYS">
         <children>
            <Button mnemonicParsing="false" onAction="#onCancelClick" text="Cancel" styleClass="secondary-btn"/>
